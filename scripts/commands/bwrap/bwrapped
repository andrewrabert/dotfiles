class Sandbox(abc.ABC):
    """One sandbox backend: a command plus the mounts and env it enforces."""

    default_config: typing.ClassVar[dict]
    # whether every bind source must already exist on the host
    requires_existing_sources: typing.ClassVar[bool]

    @abc.abstractmethod
    def prepare(self) -> None:
        """Emit platform plumbing before any bind: /proc, tmpfs, scratch."""

    # a Bind for one default mount, or None to skip it on this platform
    def default_bind(self, path: pathlib.Path, *, readonly: bool):
        bind_type = ReadOnlyBind if readonly else ReadWriteBind
        return bind_type(source=path, target=path)

    def finish_mounts(self) -> None:
        """Emit anything the binds deferred."""

    @abc.abstractmethod
    def ro_bind(self, src, dest=None):
        """Grant read-only access to src."""

    @abc.abstractmethod
    def bind(self, src, dest=None):
        """Grant read-write access to src."""

    @abc.abstractmethod
    def hide(self, path) -> None:
        """Make path unreadable however broadly its directory was granted."""

    @abc.abstractmethod
    def exclude(self, path: pathlib.Path) -> None:
        """Hide an existing file or directory tree."""

    @abc.abstractmethod
    def setenv(self, name, value=None):
        """Set name inside the sandbox; None inherits the wrapper's value."""

    @abc.abstractmethod
    def unsetenv(self, name):
        """Remove name from the sandbox environment."""

    @abc.abstractmethod
    def chdir(self, path) -> None:
        """Set the sandboxed program's working directory."""

    @abc.abstractmethod
    def arg(self, *args) -> None:
        """Append the program and its arguments."""

    @abc.abstractmethod
    def command(self) -> list[str]:
        """The full command to launch."""

    def spawn_env(self) -> dict[str, str] | None:
        return None

    def spawn_cwd(self) -> pathlib.Path | None:
        return None

    def close(self) -> None:
        """Release anything prepare() created on the host."""


class Bubblewrap(Sandbox):
    _BIN = "bwrap"

    default_config = {
        "proc": ["/proc"],
        "dev": ["/dev"],
        "tmpfs": ["/tmp", "/run"],
        "dir": [f"/run/user/{os.getuid()}"],
        "bind": {
            "rw": [WORK_DIR],
            "ro": [
                *SHARED_RO_PATHS,
                "/etc",
                "/lib",
                "/lib64",
                "/run/systemd/resolve",
                "/run/log/journal",
                "/var/log/journal",
                "/var/lib/systemd/coredump",
            ],
        },
        "env": {
            "inherit": ["PATH", "TERM", "USER"],
            "unset": SANDBOX_UNSETENV,
            "set": {
                "HOME": HOME,
                "TMPDIR": "/tmp",
            },
        },
        "chdir": WORK_DIR,
    }
    requires_existing_sources = True

    def __init__(self):
        self._args = [self._BIN]
        self._symlinks: list[tuple[pathlib.Path, pathlib.Path]] = []
        self._chdir: pathlib.Path | None = None
        self._trailer: list[str] = []

    def _add(self, *args):
        self._args.extend(str(a) for a in args if a is not None)
        return self

    def prepare(self) -> None:
        config = self.default_config
        for p in config["proc"]:
            self._add("--proc", p)
        for p in config["dev"]:
            self._add("--dev", p)
        for p in config["tmpfs"]:
            self._add("--tmpfs", p)
        for p in config["dir"]:
            self._add("--dir", p)

    def default_bind(self, path, *, readonly):
        if not path.exists():
            return None
        # bwrap can't mount onto a symlink; bind the target, recreate the
        # link.
        if path.is_symlink():
            target = path.resolve()
            self._symlinks.append((target, path))
            path = target
        return super().default_bind(path, readonly=readonly)

    def finish_mounts(self) -> None:
        for target, link in self._symlinks:
            self._add("--symlink", target, link)

    def ro_bind(self, src, dest=None):
        return self._add("--ro-bind", src, dest or src)

    def bind(self, src, dest=None):
        return self._add("--bind", src, dest or src)

    def hide(self, path) -> None:
        self.ro_bind("/dev/null", path)

    def exclude(self, path: pathlib.Path) -> None:
        if path.is_dir():
            self._add("--tmpfs", path)
        else:
            self.bind("/dev/null", path)

    def setenv(self, name, value=None):
        if value is None:
            value = os.environ.get(name, "")
        return self._add("--setenv", name, value)

    def unsetenv(self, name):
        return self._add("--unsetenv", name)

    def chdir(self, path) -> None:
        self._chdir = pathlib.Path(path)

    def arg(self, *args) -> None:
        self._trailer.extend(str(a) for a in args if a is not None)

    def command(self) -> list[str]:
        chdir = [] if self._chdir is None else ["--chdir", str(self._chdir)]
        return [
            *self._args,
            *chdir,
            "--unshare-pid",
            "--die-with-parent",
            *self._trailer,
        ]


class Seatbelt(Sandbox):
    _BIN = "sandbox-exec"

    default_config = {
        "bind": {
            "rw": [
                "/dev",
                WORK_DIR,
            ],
            "ro": [
                *SHARED_RO_PATHS,
                "/Applications",
                "/Library",
                "/System",
                "/private/etc",
                "/private/var/db",
                "/private/var/select",
                "/sbin",
            ],
        },
        "env": {
            "inherit": [],
            "unset": SANDBOX_UNSETENV,
            "set": {
                "HOME": HOME,
            },
        },
        "chdir": WORK_DIR,
    }
    requires_existing_sources = False

    # Rights every process needs before it can reach a single file, and the
    # traversal of every parent directory on the way to an allowed path.
    _PREAMBLE = (
        "(deny default)",
        "(allow process-exec* process-fork process-info* signal)",
        "(allow sysctl-read)",
        "(allow mach-lookup mach-task-name)",
        "(allow ipc-posix-shm)",
        "(allow file-read-metadata)",
        '(allow file-read* (literal "/"))',
        '(allow file-write-data (literal "/dev/null") (literal "/dev/tty"))',
        '(allow file-ioctl (literal "/dev/dtracehelper") (literal "/dev/tty"))',
    )

    def __init__(self):
        self._rules = ["(version 1)", *self._PREAMBLE, "(allow network*)"]
        self._denials: list[str] = []
        self._env = dict(os.environ)
        self._cwd: pathlib.Path | None = None
        self._trailer: list[str] = []
        self._scratch: pathlib.Path | None = None

    # A rule naming one fully resolved path. Seatbelt matches the real file,
    # so a symlink is stated as whatever it points at. A path that does not
    # exist yet covers its whole tree, which is what lets the sandbox create
    # a directory the rule was written for.
    @staticmethod
    def _rule(action, operation, path):
        path = pathlib.Path(path).resolve()
        pattern = "literal" if path.is_file() else "subpath"
        quoted = str(path).replace("\\", "\\\\").replace('"', '\\"')
        return f'({action} {operation} ({pattern} "{quoted}"))'

    # Where bubblewrap mounts an empty tmpfs over /tmp, seatbelt cannot
    # replace a directory, so the sandbox gets a private directory of its own
    # and the host /tmp stays unreachable.
    def prepare(self) -> None:
        self._scratch = pathlib.Path(
            tempfile.mkdtemp(prefix="bwrapped-")
        ).resolve()
        self.bind(self._scratch)
        self.setenv("TMPDIR", self._scratch)

    # Seatbelt cannot remap a path, so a destination that renames its source
    # cannot be honored at all.
    def _same_path(self, src, dest):
        if dest is not None and pathlib.Path(dest) != pathlib.Path(src):
            raise SandboxError(
                f"seatbelt cannot mount {src} at {dest}: destinations must"
                " match their source"
            )

    # The write denial sits beside its own allow rather than with the
    # trailing denials, so a later read-write rule for a path underneath
    # still wins.
    def ro_bind(self, src, dest=None):
        self._same_path(src, dest)
        self._rules.append(self._rule("allow", "file-read*", src))
        self._rules.append(self._rule("deny", "file-write*", src))
        return self

    def bind(self, src, dest=None):
        self._same_path(src, dest)
        self._rules.append(
            self._rule("allow", "file* file-read* file-write* file-ioctl", src)
        )
        return self

    # Denials are emitted after every rule, so the path cannot be read
    # however broadly its directory was granted.
    def hide(self, path) -> None:
        self._denials.append(self._rule("deny", "file-read*", path))

    def exclude(self, path: pathlib.Path) -> None:
        self.hide(path)

    def setenv(self, name, value=None):
        if value is None:
            value = os.environ.get(name, "")
        self._env[name] = str(value)
        return self

    def unsetenv(self, name):
        self._env.pop(name, None)
        return self

    def chdir(self, path) -> None:
        self._cwd = pathlib.Path(path)

    def arg(self, *args) -> None:
        self._trailer.extend(str(a) for a in args if a is not None)

    def command(self) -> list[str]:
        profile = "\n".join([*self._rules, *self._denials]) + "\n"
        return [self._BIN, "-p", profile, *self._trailer]

    def spawn_env(self) -> dict[str, str]:
        return dict(self._env)

    def spawn_cwd(self) -> pathlib.Path | None:
        return self._cwd

    def close(self) -> None:
        if self._scratch is not None:
            shutil.rmtree(self._scratch, ignore_errors=True)



        description="Disable noted integration and remove NOTED_ variables",
    )
    program: pydantic_settings.CliPositionalArg[str] = pydantic.Field(
        description="Program to run inside the sandbox"
    )
    program_args: pydantic_settings.CliUnknownArgs
    write_config: pathlib.Path | None = pydantic.Field(
        None,
        description=(
            "Write the effective settings as TOML; a directory means its "
            f"{CONFIG_NAME}"
        ),
    )


# the nearest .bwrapped.conf at or above directory, if one exists
def find_config(directory: pathlib.Path) -> pathlib.Path | None:
    for parent in (directory, *directory.parents):
        candidate = parent / CONFIG_NAME
        if candidate.is_file():
            return candidate
    return None


def unique_binds(binds: list[Bind]) -> list[Bind]:
    unique: list[Bind] = []
    seen: set[pathlib.Path] = set()
    for bind in reversed(binds):
        if bind.destination not in seen:
            seen.add(bind.destination)
            unique.append(bind)
    unique.reverse()
    return unique


def split_binds(
    binds: list[Bind], *, require_sources: bool
) -> tuple[list[Bind], list[Bind]]:
    outside: list[Bind] = []
    inside: list[Bind] = []

    for bind in binds:
        if require_sources and not bind.source.exists():
            raise SandboxError(f"does not exist: {bind}")
        if bind.destination.is_relative_to(WORK_DIR):
            inside.append(bind)
        else:
            outside.append(bind)

    return outside, inside


# CLI scalars override TOML scalars; collections merge TOML then CLI.
def load_settings(config_path: pathlib.Path | None) -> InvocationSettings:
    cli = InvocationSettings()
    if config_path is None:
        project = SandboxSettings.model_validate({})
    else:
        try:
            values = pydantic_settings.TomlConfigSettingsSource(
                SandboxSettings, toml_file=config_path
            )()
            project = SandboxSettings.model_validate(values)
        except (OSError, ValueError, pydantic_settings.SettingsError) as e:
            raise SandboxError(f"cannot load {config_path}: {e}") from e

    config_dir = WORK_DIR if config_path is None else config_path.parent
    updates: dict[str, typing.Any] = {
        "bind": unique_binds(
            [
                *(bind.relative_to(config_dir) for bind in project.bind),
                *(bind.relative_to(WORK_DIR) for bind in cli.bind),
            ]
        ),
        "exclude": [
            *(
                (path if path.is_absolute() else config_dir / path).resolve()
                for path in project.exclude
            ),
            *(
                (path if path.is_absolute() else WORK_DIR / path).resolve()
                for path in cli.exclude
            ),
        ],
        "disable": [*project.disable, *cli.disable],
        "env": {**project.env, **cli.env},
    }
    for field in ("ro", "noted_scope", "noted_source"):
        if field not in cli.model_fields_set:
            updates[field] = getattr(project, field)
    return cli.model_copy(update=updates)


# Write effective settings; absolute sources preserve their meaning at any
# PATH.
def write_config(settings: InvocationSettings, path: pathlib.Path) -> None:
    if path.is_dir():
        path /= CONFIG_NAME
    value: dict[str, typing.Any] = {
        "ro": settings.ro,
        "bind": [
            bind.relative_to(WORK_DIR).serialize() for bind in settings.bind
        ],
        "exclude": [str(path) for path in settings.exclude],
        "disable": settings.disable,
        "env": settings.env,
    }
    if settings.noted_scope is not None:
        value["noted_scope"] = settings.noted_scope
    if settings.noted_source is not None:
        value["noted_source"] = settings.noted_source
    try:
        with path.open("wb") as config_file:
            tomli_w.dump(value, config_file)
    except OSError as e:
        raise SandboxError(f"cannot write {path}: {e}") from e


# a preexec callable that has the kernel SIGKILL the child once parent_pid
#   dies, and exits the child when that death beat the prctl
# prctl is Linux-only; elsewhere the server outlives a SIGKILLed wrapper
def die_with_parent(
    parent_pid: int,
) -> collections.abc.Callable[[], None] | None:
    if platform.system() != "Linux":
        return None
    PR_SET_PDEATHSIG = 1
    libc = ctypes.CDLL(None, use_errno=True)

    def arm() -> None:
        libc.prctl(PR_SET_PDEATHSIG, signal.SIGKILL, 0, 0, 0)
        if os.getppid() != parent_pid:
            os._exit(1)

    return arm


# the first line of fd without its newline, within ENDPOINT_TIMEOUT seconds
# a timeout, an EOF, and a line that is not `unix://<path>` are rejected
def read_endpoint_line(fd: int) -> str:
    deadline = time.monotonic() + ENDPOINT_TIMEOUT
    buffered = b""
    with selectors.DefaultSelector() as selector:
        selector.register(fd, selectors.EVENT_READ)
        while b"\n" not in buffered:
            remaining = deadline - time.monotonic()
            if remaining <= 0 or not selector.select(remaining):
                raise SandboxError(
                    "noted server socket announced no endpoint within"
                    f" {ENDPOINT_TIMEOUT:g}s"
                )
            chunk = os.read(fd, 4096)
            if not chunk:
                raise SandboxError(
                    "noted server socket closed stdout before announcing"
                    " an endpoint"
                )
            buffered += chunk
    # A socket path is raw bytes; surrogateescape hands it to the sandbox
    # intact.
    line = buffered.split(b"\n", 1)[0].decode(errors="surrogateescape")
    if not line.startswith(ENDPOINT_SCHEME) or line == ENDPOINT_SCHEME:
        raise SandboxError(f"noted server socket announced {line!r}")
    return line


# SIGTERM, then SIGKILL SERVER_GRACE seconds later; returns once reaped
def terminate(process: subprocess.Popen) -> None:
    if process.poll() is None:
        process.terminate()
        try:
            process.wait(SERVER_GRACE)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()


class NotesServer:
    """The `noted server socket` process this invocation owns."""

    def __init__(self, process: subprocess.Popen, endpoint: str) -> None:
        self._process = process
        self._endpoint = endpoint

    # cwd `/`, so no `.notedenv` at or above the invocation directory is read
    #   and the root comes from the wrapper's own NOTED_DIR or noted.env
    # the spawn environment is the wrapper's own minus NOTED_URL
    # its own session, so no terminal-generated signal reaches it
    # dies with the wrapper where the platform can arrange it
    # stdin /dev/null, stderr /dev/null, stdout a pipe held open until stop
    # a `noted` PATH holds no entry for, and any rejected endpoint line,
    #   terminates the process and raises SandboxError
    @classmethod
    def start(cls, scope: str) -> "NotesServer":
        env = {k: v for k, v in os.environ.items() if k != "NOTED_URL"}
        scope = scope or ""
        try:
            process = subprocess.Popen(
                ["noted", "server", "socket", f"--scope={scope}"],
                cwd=NOTED_SERVER_CWD,
                env=env,
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                bufsize=0,
                start_new_session=True,
                preexec_fn=die_with_parent(os.getpid()),
            )
        except OSError as e:
            raise SandboxError(f"cannot run noted: {e}") from e
        try:
            endpoint = read_endpoint_line(process.stdout.fileno())
        except SandboxError:
            terminate(process)
            raise
        return cls(process, endpoint)

    @property
    def endpoint(self) -> str:
        return self._endpoint

    @property
    def socket(self) -> pathlib.Path:
        return pathlib.Path(self._endpoint[len(ENDPOINT_SCHEME) :])

    def stop(self) -> None:
        terminate(self._process)
        self._process.stdout.close()


def which_all(name: str) -> list[pathlib.Path]:
    matches: list[pathlib.Path] = []
    seen: set[pathlib.Path] = set()
    path = os.environ.get("PATH", os.defpath)
    for directory in path.split(os.pathsep):
        match = shutil.which(name, path=directory)
        if match is None:
            continue
        candidate = pathlib.Path(match).resolve()
        if candidate not in seen:
            seen.add(candidate)
            matches.append(candidate)
    return matches


# the file PATH resolves name to
# a name PATH holds no entry for is rejected
def resolve_program(name: str) -> pathlib.Path:
    path = shutil.which(name)
    if path is None:
        raise SandboxError(f"{name} not found on PATH")
    return pathlib.Path(path)


# the sandbox's exit status, 128 + signum when a signal killed it
# SIGINT and SIGQUIT are handled rather than ignored: exec resets a handled
#   signal to its default, so Ctrl-C still reaches the sandboxed program
def run_sandbox(sandbox: Sandbox) -> int:
    def keep_waiting(signum: int, frame: types.FrameType | None) -> None:
        pass

    for sig in (signal.SIGINT, signal.SIGQUIT):
        signal.signal(sig, keep_waiting)
    cmd = sandbox.command()
    try:
        process = subprocess.Popen(
            cmd, env=sandbox.spawn_env(), cwd=sandbox.spawn_cwd()
        )
    except OSError as e:
        raise SandboxError(f"cannot launch {cmd[0]}: {e}") from e
    status = process.wait()
    return status if status >= 0 else 128 - status


def build_sandbox(
    sandbox: Sandbox,
    args: InvocationSettings,
    program: pathlib.Path,
    endpoint: str | None,
    socket: pathlib.Path | None,
    config_path: pathlib.Path | None,
) -> Sandbox:
    config = sandbox.default_config
    extra = PROGRAM_CONFIG.get(program.name, {})

    sandbox.prepare()

    ro_paths = config["bind"]["ro"] + extra.get("bind", {}).get("ro", [])
    rw_paths = config["bind"]["rw"] + extra.get("bind", {}).get("rw", [])
    tmux = os.environ.get("TMUX")
    if tmux:
        rw_paths = [*rw_paths, tmux.split(",", 1)[0]]
    if args.ro:
        ro_paths = [*ro_paths, WORK_DIR]
        rw_paths = [p for p in rw_paths if pathlib.Path(p) != WORK_DIR]

    default_binds: list[Bind] = []

    def add_default(p, *, readonly):
        p = pathlib.Path(p)
        # A rw workdir mount already provides everything beneath it.
        if not args.ro and p != WORK_DIR and p.is_relative_to(WORK_DIR):
            return
        bind = sandbox.default_bind(p, readonly=readonly)
        if bind is not None:
            default_binds.append(bind)

    for p in ro_paths:
        add_default(p, readonly=True)
    for p in rw_paths:
        add_default(p, readonly=False)

    outside_binds, inside_binds = split_binds(
        [
            *default_binds,
            *(requested.relative_to(WORK_DIR) for requested in args.bind),
        ],
        require_sources=sandbox.requires_existing_sources,
    )
    for requested in outside_binds:
        requested.mount(sandbox)

    # The only hole to the notes, `--ro` or not, and the socket file alone.
    if socket is not None:
        sandbox.bind(socket, socket)

    for requested in inside_binds:
        requested.mount(sandbox)

    sandbox.finish_mounts()

    # Apply this after every broader mount so the selected file cannot be
    # read.
    if config_path is not None:
        sandbox.hide(config_path)

    for name in args.disable:
        matches = which_all(name)
        if not matches:
            raise SandboxError(f"cannot disable {name}: not found on PATH")
        for path in matches:
            sandbox.hide(path)

    for path in args.exclude:
        if not path.exists():
            raise SandboxError(f"cannot exclude nonexistent path: {path}")
        sandbox.exclude(path)

    # An absent variable stays absent; an empty value is not the same thing.
    for name in config["env"]["inherit"] + extra.get("env", {}).get(
        "inherit", []
    ):
        if name in os.environ:
            sandbox.setenv(name)
    for name in config["env"]["unset"] + extra.get("env", {}).get("unset", []):
        sandbox.unsetenv(name)
    for name, value in {
        **config["env"]["set"],
        **extra.get("env", {}).get("set", {}),
    }.items():
        sandbox.setenv(name, value)
    if endpoint is not None:
        sandbox.setenv("NOTED_URL", endpoint)
    for name, value in args.env.items():
        sandbox.setenv(name, value)
    if args.no_noted:
        for name in (
            set(SANDBOX_UNSETENV)
            | {name for name in os.environ if name.startswith("NOTED_")}
            | {name for name in args.env if name.startswith("NOTED_")}
            | {"NOTED_URL"}
        ):
            sandbox.unsetenv(name)
    else:
        sandbox.setenv(
            "NOTED_SOURCE",
            args.program if args.noted_source is None else args.noted_source,
        )

    sandbox.chdir(config["chdir"])
    sandbox.arg(str(program))
    if args.no_noted:
        sandbox.arg(*NO_NOTED_PROGRAM_ARGS.get(program.name, []))
    sandbox.arg(*args.program_args)

    return sandbox


def main() -> None:
    config_path = find_config(WORK_DIR)
    server = None
    try:
        sandbox_type = SANDBOXES.get(platform.system())
        if sandbox_type is None:
            raise SandboxError(f"no sandbox backend for {platform.system()}")
        if not shutil.which(sandbox_type._BIN):
            raise SandboxError(f"{sandbox_type._BIN} not found")
        args = load_settings(config_path)
        if args.write_config is not None:
            write_config(args, args.write_config)
        program = resolve_program(args.program)
        if not args.no_noted:
            server = NotesServer.start(args.noted_scope)
    except (
        SandboxError,
        pydantic_settings.SettingsError,
        pydantic.ValidationError,
    ) as e:
        sys.exit(f"bwrapped: {e}")
    sandbox = sandbox_type()
    try:
        status = run_sandbox(
            build_sandbox(
                sandbox,
                args,
                program,
                None if server is None else server.endpoint,
                None if server is None else server.socket,
                config_path,
            )
        )
    except SandboxError as e:
        sys.exit(f"bwrapped: {e}")
    finally:
        sandbox.close()
        if server is not None:
            server.stop()
    sys.exit(status)


if __name__ == "__main__":
    main()

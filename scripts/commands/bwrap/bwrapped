class SandboxError(Exception):
    """A failure that leaves no sandbox and no server running."""


class Bind(pydantic.BaseModel, abc.ABC):
    """One abstract bind mount."""

    model_config = pydantic.ConfigDict(extra="forbid", frozen=True)

    source: pathlib.Path
    target: pathlib.Path | None = None

    @classmethod
    def from_str(cls, value: str) -> "Bind":
        parts: list[str] = []
        part: list[str] = []
        escaped = False
        for char in value:
            if escaped:
                if char not in (":", "\\"):
                    raise ValueError(f"unsupported escape \\{char}")
                part.append(char)
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == ":":
                parts.append("".join(part))
                part = []
            else:
                part.append(char)
        if escaped:
            raise ValueError("bind ends with an incomplete escape")
        parts.append("".join(part))

        if not parts[0]:
            raise ValueError("bind source cannot be empty")
        if len(parts) > 3:
            raise ValueError("bind must be SOURCE[:DESTINATION[:ro|rw]]")

        target = (
            pathlib.Path(parts[1]) if len(parts) >= 2 and parts[1] else None
        )
        mode = parts[2] if len(parts) == 3 else "rw"
        if mode not in ("ro", "rw"):
            raise ValueError("bind mode must be 'ro' or 'rw'")
        bind_type = ReadOnlyBind if mode == "ro" else ReadWriteBind
        return bind_type(source=pathlib.Path(parts[0]), target=target)

    @pydantic.field_validator("target", mode="before")
    @classmethod
    def empty_target_means_source(cls, value: typing.Any) -> typing.Any:
        return None if value == "" else value

    def relative_to(self, directory: pathlib.Path) -> "Bind":
        source = self.source
        if not source.is_absolute():
            source = directory / source
        return self.model_copy(update={"source": source.resolve()})

    @property
    def destination(self) -> pathlib.Path:
        return self.source if self.target is None else self.target

    def serialized(self, *, read_only: bool) -> dict[str, typing.Any]:
        value: dict[str, typing.Any] = {
            "source": str(self.source),
            "read_only": read_only,
        }
        if self.target is not None:
            value["target"] = str(self.target)
        return value

    @abc.abstractmethod
    def mount(self, bwrap: Bubblewrap) -> None:
        """Add this mount to a Bubblewrap command."""

    @abc.abstractmethod
    def serialize(self) -> dict[str, typing.Any]:
        """Serialize this concrete mount for a project config."""


class ReadOnlyBind(Bind):
    def mount(self, bwrap: Bubblewrap) -> None:
        bwrap.ro_bind(self.source, self.destination)

    def serialize(self) -> dict[str, typing.Any]:
        return self.serialized(read_only=True)


class ReadWriteBind(Bind):
    def mount(self, bwrap: Bubblewrap) -> None:
        bwrap.bind(self.source, self.destination)

    def serialize(self) -> dict[str, typing.Any]:
        return self.serialized(read_only=False)


class SandboxSettings(pydantic_settings.BaseSettings):
    """Sandbox options shared by the project file and command line."""

    model_config = pydantic_settings.SettingsConfigDict(extra="forbid")

    ro: pydantic_settings.CliImplicitFlag[bool] = pydantic.Field(
        False, description="Mount the working directory read-only"
    )
    bind: list[Bind] = pydantic.Field(
        default_factory=list,
        description="Bind SOURCE[:DESTINATION[:ro|rw]] (repeatable)",
    )
    env: dict[str, str] = pydantic.Field(
        default_factory=dict,
        description="Set KEY=VALUE (repeatable)",
    )
    noted_scope: str | None = pydantic.Field(
        None, description="Restrict the notes server to this scope"
    )
    noted_source: str | None = pydantic.Field(
        None, description="Set NOTED_SOURCE (defaults to PROGRAM)"
    )

    @pydantic.field_validator("bind", mode="before")
    @classmethod
    def deserialize_binds(cls, value: typing.Any) -> typing.Any:
        if not isinstance(value, list):
            return value

        binds: list[typing.Any] = []
        for item in value:
            if isinstance(item, str):
                binds.append(Bind.from_str(item))
                continue
            if isinstance(item, dict):
                fields = dict(item)
                read_only = fields.pop("read_only", False)
                if not isinstance(read_only, bool):
                    raise ValueError("bind read_only must be a boolean")
                bind_type = ReadOnlyBind if read_only else ReadWriteBind
                binds.append(bind_type.model_validate(fields))
                continue
            binds.append(item)
        return binds

    @classmethod
    def settings_customise_sources(
        cls,
        settings_cls: type[pydantic_settings.BaseSettings],
        init_settings: pydantic_settings.PydanticBaseSettingsSource,
        env_settings: pydantic_settings.PydanticBaseSettingsSource,
        dotenv_settings: pydantic_settings.PydanticBaseSettingsSource,
        file_secret_settings: pydantic_settings.PydanticBaseSettingsSource,
    ) -> tuple[pydantic_settings.PydanticBaseSettingsSource, ...]:
        # Invocation settings come only from the CLI and selected TOML file.
        return (init_settings,)


class InvocationSettings(SandboxSettings):
    """Run a program inside a bubblewrap sandbox with filesystem isolation."""

    model_config = pydantic_settings.SettingsConfigDict(
        cli_parse_args=True,
        cli_kebab_case=True,
        cli_ignore_unknown_args=True,
        cli_shortcuts={"bind": "b", "env": "e", "write-config": "w"},
        extra="forbid",
    )

    program: pydantic_settings.CliPositionalArg[str] = pydantic.Field(
        description="Program to run inside the sandbox"
    )
    program_args: pydantic_settings.CliUnknownArgs
    write_config: pathlib.Path | None = pydantic.Field(
        None,
        description=(
            "Write the effective settings as TOML; a directory means its "
            f"{CONFIG_NAME}"
        ),
    )


# the nearest .bwrapped.conf at or above directory, if one exists
def find_config(directory: pathlib.Path) -> pathlib.Path | None:
    for parent in (directory, *directory.parents):
        candidate = parent / CONFIG_NAME
        if candidate.is_file():
            return candidate
    return None


def unique_binds(binds: list[Bind]) -> list[Bind]:
    unique: list[Bind] = []
    seen: set[pathlib.Path] = set()
    for bind in reversed(binds):
        if bind.destination not in seen:
            seen.add(bind.destination)
            unique.append(bind)
    unique.reverse()
    return unique


def split_binds(binds: list[Bind]) -> tuple[list[Bind], list[Bind]]:
    outside: list[Bind] = []
    inside: list[Bind] = []

    for bind in binds:
        if not bind.source.exists():
            raise RuntimeError(f"does not exist: {bind}")
        if bind.destination.is_relative_to(WORK_DIR):
            inside.append(bind)
        else:
            outside.append(bind)

    return outside, inside


# CLI scalars override TOML scalars; collections merge TOML then CLI.
def load_settings(config_path: pathlib.Path | None) -> InvocationSettings:
    cli = InvocationSettings()
    if config_path is None:
        project = SandboxSettings.model_validate({})
    else:
        try:
            values = pydantic_settings.TomlConfigSettingsSource(
                SandboxSettings, toml_file=config_path
            )()
            project = SandboxSettings.model_validate(values)
        except (OSError, ValueError, pydantic_settings.SettingsError) as e:
            raise SandboxError(f"cannot load {config_path}: {e}") from e

    config_dir = WORK_DIR if config_path is None else config_path.parent
    updates: dict[str, typing.Any] = {
        "bind": unique_binds(
            [
                *(bind.relative_to(config_dir) for bind in project.bind),
                *(bind.relative_to(WORK_DIR) for bind in cli.bind),
            ]
        ),
        "env": {**project.env, **cli.env},
    }
    for field in ("ro", "noted_scope", "noted_source"):
        if field not in cli.model_fields_set:
            updates[field] = getattr(project, field)
    return cli.model_copy(update=updates)


# Write effective settings; absolute sources preserve their meaning at any PATH.
def write_config(settings: InvocationSettings, path: pathlib.Path) -> None:
    if path.is_dir():
        path /= CONFIG_NAME
    value: dict[str, typing.Any] = {
        "ro": settings.ro,
        "bind": [
            bind.relative_to(WORK_DIR).serialize() for bind in settings.bind
        ],
        "env": settings.env,
    }
    if settings.noted_scope is not None:
        value["noted_scope"] = settings.noted_scope
    if settings.noted_source is not None:
        value["noted_source"] = settings.noted_source
    try:
        with path.open("wb") as config_file:
            tomli_w.dump(value, config_file)
    except OSError as e:
        raise SandboxError(f"cannot write {path}: {e}") from e


# a preexec callable that has the kernel SIGKILL the child once parent_pid
#   dies, and exits the child when that death beat the prctl
def die_with_parent(parent_pid: int) -> collections.abc.Callable[[], None]:
    def arm() -> None:
        LIBC.prctl(PR_SET_PDEATHSIG, signal.SIGKILL, 0, 0, 0)
        if os.getppid() != parent_pid:
            os._exit(1)

    return arm


# the first line of fd without its newline, within ENDPOINT_TIMEOUT seconds
# a timeout, an EOF, and a line that is not `unix://<path>` are rejected
def read_endpoint_line(fd: int) -> str:
    deadline = time.monotonic() + ENDPOINT_TIMEOUT
    buffered = b""
    with selectors.DefaultSelector() as selector:
        selector.register(fd, selectors.EVENT_READ)
        while b"\n" not in buffered:
            remaining = deadline - time.monotonic()
            if remaining <= 0 or not selector.select(remaining):
                raise SandboxError(
                    "noted server socket announced no endpoint within"
                    f" {ENDPOINT_TIMEOUT:g}s"
                )
            chunk = os.read(fd, 4096)
            if not chunk:
                raise SandboxError(
                    "noted server socket closed stdout before announcing"
                    " an endpoint"
                )
            buffered += chunk
    # A socket path is raw bytes; surrogateescape hands it to bwrap intact.
    line = buffered.split(b"\n", 1)[0].decode(errors="surrogateescape")
    if not line.startswith(ENDPOINT_SCHEME) or line == ENDPOINT_SCHEME:
        raise SandboxError(f"noted server socket announced {line!r}")
    return line


# SIGTERM, then SIGKILL SERVER_GRACE seconds later; returns once reaped
def terminate(process: subprocess.Popen) -> None:
    if process.poll() is None:
        process.terminate()
        try:
            process.wait(SERVER_GRACE)
        except subprocess.TimeoutExpired:
            process.kill()
            process.wait()


class NotesServer:
    """The `noted server socket` process this invocation owns."""

    def __init__(self, process: subprocess.Popen, endpoint: str) -> None:
        self._process = process
        self._endpoint = endpoint

    # cwd `/`, so no `.notedenv` at or above the invocation directory is read
    #   and the root comes from the wrapper's own NOTED_DIR or noted.env
    # the spawn environment is the wrapper's own minus NOTED_URL
    # its own session, so no terminal-generated signal reaches it
    # dies with the wrapper, a SIGKILLed wrapper included
    # stdin /dev/null, stderr /dev/null, stdout a pipe held open until stop
    # a `noted` PATH holds no entry for, and any rejected endpoint line,
    #   terminates the process and raises SandboxError
    @classmethod
    def start(cls, scope: str) -> "NotesServer":
        env = {k: v for k, v in os.environ.items() if k != "NOTED_URL"}
        scope = scope or ""
        process = subprocess.Popen(
            ["noted", "server", "socket", f"--scope={scope}"],
            cwd=NOTED_SERVER_CWD,
            env=env,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            bufsize=0,
            start_new_session=True,
            preexec_fn=die_with_parent(os.getpid()),
        )
        try:
            endpoint = read_endpoint_line(process.stdout.fileno())
        except SandboxError:
            terminate(process)
            raise
        return cls(process, endpoint)

    @property
    def endpoint(self) -> str:
        return self._endpoint

    @property
    def socket(self) -> pathlib.Path:
        return pathlib.Path(self._endpoint[len(ENDPOINT_SCHEME) :])

    def stop(self) -> None:
        terminate(self._process)
        self._process.stdout.close()


# the file PATH resolves name to
# a name PATH holds no entry for is rejected
def resolve_program(name: str) -> pathlib.Path:
    path = shutil.which(name)
    if path is None:
        raise SandboxError(f"{name} not found on PATH")
    return pathlib.Path(path)


# the sandbox's exit status, 128 + signum when a signal killed it
# SIGINT and SIGQUIT are handled rather than ignored: exec resets a handled
#   signal to its default, so Ctrl-C still reaches the sandboxed program
def run_sandbox(cmd: list[str]) -> int:
    def keep_waiting(signum: int, frame: types.FrameType | None) -> None:
        pass

    for sig in (signal.SIGINT, signal.SIGQUIT):
        signal.signal(sig, keep_waiting)
    try:
        sandbox = subprocess.Popen(cmd)
    except OSError as e:
        raise SandboxError(f"cannot launch {cmd[0]}: {e}") from e
    status = sandbox.wait()
    return status if status >= 0 else 128 - status


def build_command(
    args: InvocationSettings,
    program: pathlib.Path,
    endpoint: str,
    socket: pathlib.Path,
    config_path: pathlib.Path | None,
) -> list[str]:
    config = DEFAULT_CONFIG
    extra = PROGRAM_CONFIG.get(program.name, {})

    bwrap = Bubblewrap()
    for p in config["proc"]:
        bwrap.proc(p)
    for p in config["dev"]:
        bwrap.dev(p)
    for p in config["tmpfs"]:
        bwrap.tmpfs(p)
    for p in config["dir"]:
        bwrap.dir(p)
    ro_paths = config["bind"]["ro"] + extra.get("bind", {}).get("ro", [])
    rw_paths = config["bind"]["rw"] + extra.get("bind", {}).get("rw", [])
    if args.ro:
        ro_paths = [*ro_paths, WORK_DIR]
        rw_paths = [p for p in rw_paths if pathlib.Path(p) != WORK_DIR]

    def add_bind(p, *, readonly):
        p = pathlib.Path(p)
        if not p.exists():
            return
        bind = bwrap.ro_bind if readonly else bwrap.bind
        # A rw workdir mount already provides everything beneath it.
        if not args.ro and p != WORK_DIR and p.is_relative_to(WORK_DIR):
            return
        # bwrap can't mount onto a symlink; bind the target, recreate the link.
        if p.is_symlink():
            target = p.resolve()
            bind(target, target)
            bwrap.symlink(target, p)
        else:
            bind(p, p)

    outside_binds, inside_binds = split_binds(
        [requested.relative_to(WORK_DIR) for requested in args.bind]
    )
    for requested in outside_binds:
        requested.mount(bwrap)

    for p in ro_paths:
        add_bind(p, readonly=True)
    for p in rw_paths:
        add_bind(p, readonly=False)

    # The only hole to the notes, `--ro` or not, and the socket file alone.
    bwrap.bind(socket, socket)

    for requested in inside_binds:
        requested.mount(bwrap)

    # Apply this after every broader mount so the selected file cannot be read.
    if config_path is not None:
        bwrap.ro_bind("/dev/null", config_path)

    for name in config["env"]["inherit"] + extra.get("env", {}).get(
        "inherit", []
    ):
        bwrap.setenv(name)
    for name in config["env"]["unset"] + extra.get("env", {}).get("unset", []):
        bwrap.unsetenv(name)
    for name, value in {
        **config["env"]["set"],
        **extra.get("env", {}).get("set", {}),
        "NOTED_URL": endpoint,
    }.items():
        bwrap.setenv(name, value)
    for name, value in args.env.items():
        bwrap.setenv(name, value)
    bwrap.setenv(
        "NOTED_SOURCE",
        args.program if args.noted_source is None else args.noted_source,
    )

    bwrap.chdir(config["chdir"])
    bwrap.unshare_pid(config["unshare_pid"])
    bwrap.die_with_parent(config["die_with_parent"])
    bwrap.arg(str(program))
    bwrap.arg(*args.program_args)

    return list(bwrap)


def main() -> None:
    config_path = find_config(WORK_DIR)
    try:
        args = load_settings(config_path)
        if args.write_config is not None:
            write_config(args, args.write_config)
        program = resolve_program(args.program)
        server = NotesServer.start(args.noted_scope)
    except (
        SandboxError,
        pydantic_settings.SettingsError,
        pydantic.ValidationError,
    ) as e:
        sys.exit(f"bwrapped: {e}")
    try:
        status = run_sandbox(
            build_command(
                args,
                program,
                server.endpoint,
                server.socket,
                config_path,
            )
        )
    except SandboxError as e:
        sys.exit(f"bwrapped: {e}")
    finally:
        server.stop()
    sys.exit(status)


if __name__ == "__main__":
    main()

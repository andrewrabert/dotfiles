class Bind(pydantic.BaseModel, abc.ABC):
    """One abstract bind mount."""

    model_config = pydantic.ConfigDict(extra="forbid", frozen=True)

    source: pathlib.Path
    target: pathlib.Path | None = None

    @classmethod
    def from_str(cls, value: str) -> "Bind":
        parts: list[str] = []
        part: list[str] = []
        escaped = False
        for char in value:
            if escaped:
                if char not in (":", "\\"):
                    raise ValueError(f"unsupported escape \\{char}")
                part.append(char)
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == ":":
                parts.append("".join(part))
                part = []
            else:
                part.append(char)
        if escaped:
            raise ValueError("bind ends with an incomplete escape")
        parts.append("".join(part))

        if not parts[0]:
            raise ValueError("bind source cannot be empty")
        if len(parts) > 3:
            raise ValueError("bind must be SOURCE[:DESTINATION[:ro|rw]]")

        target = (
            pathlib.Path(parts[1]) if len(parts) >= 2 and parts[1] else None
        )
        mode = parts[2] if len(parts) == 3 else "rw"
        if mode not in ("ro", "rw"):
            raise ValueError("bind mode must be 'ro' or 'rw'")
        bind_type = ReadOnlyBind if mode == "ro" else ReadWriteBind
        return bind_type(source=pathlib.Path(parts[0]), target=target)

    @pydantic.field_validator("target", mode="before")
    @classmethod
    def empty_target_means_source(cls, value: typing.Any) -> typing.Any:
        return None if value == "" else value

    def relative_to(self, directory: pathlib.Path) -> "Bind":
        source = self.source
        if not source.is_absolute():
            source = directory / source
        return self.model_copy(update={"source": source.resolve()})

    @property
    def destination(self) -> pathlib.Path:
        return self.source if self.target is None else self.target

    def serialized(self, *, read_only: bool) -> dict[str, typing.Any]:
        value: dict[str, typing.Any] = {
            "source": str(self.source),
            "read_only": read_only,
        }
        if self.target is not None:
            value["target"] = str(self.target)
        return value

    @abc.abstractmethod
    def mount(self, sandbox: Sandbox) -> None:
        """Add this mount to a sandbox."""

    @abc.abstractmethod
    def serialize(self) -> dict[str, typing.Any]:
        """Serialize this concrete mount for a project config."""


class ReadOnlyBind(Bind):
    def mount(self, sandbox: Sandbox) -> None:
        sandbox.ro_bind(self.source, self.destination)

    def serialize(self) -> dict[str, typing.Any]:
        return self.serialized(read_only=True)


class ReadWriteBind(Bind):
    def mount(self, sandbox: Sandbox) -> None:
        sandbox.bind(self.source, self.destination)

    def serialize(self) -> dict[str, typing.Any]:
        return self.serialized(read_only=False)


class SandboxSettings(pydantic_settings.BaseSettings):
    """Sandbox options shared by the project file and command line."""

    model_config = pydantic_settings.SettingsConfigDict(extra="forbid")

    ro: pydantic_settings.CliImplicitFlag[bool] = pydantic.Field(
        False, description="Mount the working directory read-only"
    )
    bind: list[Bind] = pydantic.Field(
        default_factory=list,
        description="Bind SOURCE[:DESTINATION[:ro|rw]] (repeatable)",
    )
    exclude: list[pathlib.Path] = pydantic.Field(
        default_factory=list,
        description="Hide PATH inside the sandbox (repeatable)",
    )
    disable: list[str] = pydantic.Field(
        default_factory=list,
        description="Disable every PATH match for NAME (repeatable)",
    )
    env: dict[str, str] = pydantic.Field(
        default_factory=dict,
        description="Set KEY=VALUE (repeatable)",
    )
    noted_scope: str | None = pydantic.Field(
        None, description="Restrict the notes server to this scope"
    )
    noted_source: str | None = pydantic.Field(
        None, description="Set NOTED_SOURCE (defaults to PROGRAM)"
    )

    @pydantic.field_validator("bind", mode="before")
    @classmethod
    def deserialize_binds(cls, value: typing.Any) -> typing.Any:
        if not isinstance(value, list):
            return value

        binds: list[typing.Any] = []
        for item in value:
            if isinstance(item, str):
                binds.append(Bind.from_str(item))
                continue
            if isinstance(item, dict):
                fields = dict(item)
                read_only = fields.pop("read_only", False)
                if not isinstance(read_only, bool):
                    raise ValueError("bind read_only must be a boolean")
                bind_type = ReadOnlyBind if read_only else ReadWriteBind
                binds.append(bind_type.model_validate(fields))
                continue
            binds.append(item)
        return binds

    @classmethod
    def settings_customise_sources(
        cls,
        settings_cls: type[pydantic_settings.BaseSettings],
        init_settings: pydantic_settings.PydanticBaseSettingsSource,
        env_settings: pydantic_settings.PydanticBaseSettingsSource,
        dotenv_settings: pydantic_settings.PydanticBaseSettingsSource,
        file_secret_settings: pydantic_settings.PydanticBaseSettingsSource,
    ) -> tuple[pydantic_settings.PydanticBaseSettingsSource, ...]:
        # Invocation settings come only from the CLI and selected TOML file.
        return (init_settings,)


class InvocationSettings(SandboxSettings):
    """Run a program inside a sandbox with filesystem isolation."""

    model_config = pydantic_settings.SettingsConfigDict(
        cli_parse_args=True,
        cli_kebab_case=True,
        cli_ignore_unknown_args=True,
        cli_shortcuts={
            "bind": "b",
            "disable": "d",
            "env": "e",
            "exclude": "x",
            "write-config": "w",
        },
        extra="forbid",
    )

    no_noted: pydantic_settings.CliToggleFlag[bool] = pydantic.Field(

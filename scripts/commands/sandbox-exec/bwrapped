"""Run a program inside a seatbelt sandbox with filesystem isolation."""

import abc
import asyncio
import contextlib
import os
import pathlib
import platform
import shutil
import signal
import sys
import tempfile
import types
import typing

import pydantic
import pydantic_settings
import tomli_w


class SandboxError(Exception):
    """A failure that leaves no sandbox and no server running."""


class Seatbelt:
    BIN = "sandbox-exec"

    # Rights every process needs before it can reach a single file, and the
    # traversal of every parent directory on the way to an allowed path.
    _PREAMBLE = (
        "(deny default)",
        "(allow process-exec* process-fork process-info* signal)",
        "(allow sysctl-read)",
        "(allow mach-lookup mach-task-name)",
        "(allow ipc-posix-shm)",
        "(allow file-read-metadata)",
        '(allow file-read* (literal "/"))',
        '(allow file-write-data (literal "/dev/null") (literal "/dev/tty"))',
        '(allow file-ioctl (literal "/dev/dtracehelper") (literal "/dev/tty"))',
    )

    def __init__(self, *args):
        self._rules = ["(version 1)", *self._PREAMBLE]
        self._denials = []
        self._env = dict(os.environ)
        self._cwd = None
        self._args = list(args)

    # A rule naming one fully resolved path. Seatbelt matches the real file,
    # so a symlink is stated as whatever it points at. A path that does not
    # exist yet covers its whole tree, which is what lets the sandbox create
    # a directory the rule was written for.
    @staticmethod
    def _rule(action, operation, path):
        path = pathlib.Path(path).resolve()
        pattern = "literal" if path.is_file() else "subpath"
        quoted = str(path).replace("\\", "\\\\").replace('"', '\\"')
        return f'({action} {operation} ({pattern} "{quoted}"))'

    def allow(self, operation, path):
        self._rules.append(self._rule("allow", operation, path))
        return self

    # Denials are held back and emitted last, because the final rule matching
    # a path is the one that decides it.
    def deny(self, operation, path):
        self._denials.append(self._rule("deny", operation, path))
        return self

    # Seatbelt cannot remap a path, so a destination that renames its source
    # cannot be honored at all.
    def _same_path(self, src, dest):
        if dest is not None and pathlib.Path(dest) != pathlib.Path(src):
            raise SandboxError(
                f"seatbelt cannot mount {src} at {dest}: destinations must"
                " match their source"
            )

    # The write denial sits beside its own allow rather than with the trailing
    # denials, so a later read-write rule for a path underneath still wins.
    def ro_bind(self, src, dest=None):
        self._same_path(src, dest)
        self.allow("file-read*", src)
        self._rules.append(self._rule("deny", "file-write*", src))
        return self

    def bind(self, src, dest=None):
        self._same_path(src, dest)
        return self.allow("file*", src)

    def hide(self, path):
        return self.deny("file-read*", path)

    def setenv(self, name, value):
        self._env[name] = str(value)
        return self

    def unsetenv(self, name):
        self._env.pop(name, None)
        return self

    def chdir(self, path):
        self._cwd = pathlib.Path(path)
        return self

    def arg(self, *args):
        self._args.extend(str(a) for a in args if a is not None)
        return self

    def unshare_net(self, enable=True):
        self._rules.append("(deny network*)" if enable else "(allow network*)")
        return self

    @property
    def profile(self):
        return "\n".join([*self._rules, *self._denials]) + "\n"

    @property
    def env(self):
        return dict(self._env)

    @property
    def cwd(self):
        return self._cwd

    def __iter__(self):
        return iter([self.BIN, "-p", self.profile, *self._args])



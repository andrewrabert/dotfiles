#!/usr/bin/env python3
"""Forward a prompt to the `pi` CLI on a per-Claude-session pi session.

Usage: claude-pi-agent [prompt]

The prompt is taken from the positional argument; when it is omitted the
prompt is read from piped stdin instead, and handed to pi on stdin so no
argument can ever reach pi as a flag. The pi
session is keyed `claude-<CLAUDE_CODE_SESSION_ID>`, so every call within one
Claude session continues the same pi conversation. A per-session flock rejects a
second concurrent instance rather than racing the shared pi session.
"""

import argparse
import asyncio
import fcntl
import os
import sys
import tempfile


def read_stdin() -> str | None:
    if sys.stdin.isatty():
        return None
    return sys.stdin.read()


async def main() -> int:
    sid = os.environ["CLAUDE_CODE_SESSION_ID"]

    parser = argparse.ArgumentParser(
        description="Forward a prompt to the pi CLI."
    )
    parser.add_argument(
        "prompt",
        nargs="?",
        help="prompt text (read from stdin if omitted or piped)",
    )
    args = parser.parse_args()
    prompt = args.prompt if args.prompt is not None else read_stdin()
    if prompt is None:
        parser.error("no prompt: pass an argument or pipe stdin")

    lockdir = os.environ.get("XDG_RUNTIME_DIR") or tempfile.gettempdir()
    lock = open(os.path.join(lockdir, f"claude-pi-agent-{sid}.lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit(f"pi already running for session {sid}")

    process = await asyncio.create_subprocess_exec(
        "pi",
        "--print",
        "--offline",
        "--session-id",
        f"claude-{sid}",
        stdin=asyncio.subprocess.PIPE,
    )
    await process.communicate(prompt.encode())
    return process.returncode or 0


if __name__ == "__main__":
    sys.exit(asyncio.run(main()))

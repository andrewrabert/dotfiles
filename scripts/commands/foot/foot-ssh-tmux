#!/usr/bin/env zsh
case $# in
    0)
        SSH_HOST="$(kdialog --inputbox '<b>foot-ssh-tmux</b>\nEnter hostname:')"
        ;;
    1)
        SSH_HOST="$1"
        ;;
    *)
        echo 'usage: SSH_HOST' >&2
        exit 1
        ;;
esac
TITLE="${SSH_HOST} - ssh-tmux"
foot \
    --title "${TITLE}" \
    --app-id  "${TITLE}" \
    -- sh -c ". ~/.base16_theme; exec bertbox tmux-attach-ssh ${SSH_HOST}" 2> /dev/null > /dev/null &
disown
